{
  "components": {
    "schemas": {
      "ActorView": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "ActorView",
        "type": "object"
      },
      "CatalogReference": {
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "format": "uuid",
            "title": "Item Id",
            "type": "string"
          },
          "release_id": {
            "format": "uuid",
            "title": "Release Id",
            "type": "string"
          }
        },
        "required": [
          "release_id",
          "item_id"
        ],
        "title": "CatalogReference",
        "type": "object"
      },
      "CreatePlanInput": {
        "additionalProperties": false,
        "properties": {
          "conditions": {
            "$ref": "#/components/schemas/ResearchConditions-Input"
          },
          "key": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Key",
            "type": "string"
          }
        },
        "required": [
          "key",
          "conditions"
        ],
        "title": "CreatePlanInput",
        "type": "object"
      },
      "ErrorView": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "retryable"
        ],
        "title": "ErrorView",
        "type": "object"
      },
      "ObserveInput": {
        "additionalProperties": false,
        "properties": {
          "conditionsRevision": {
            "minimum": 1.0,
            "title": "Conditionsrevision",
            "type": "integer"
          },
          "runId": {
            "format": "uuid",
            "title": "Runid",
            "type": "string"
          },
          "taskId": {
            "format": "uuid",
            "title": "Taskid",
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "runId",
          "conditionsRevision"
        ],
        "title": "ObserveInput",
        "type": "object"
      },
      "PlanListView": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PlanView"
            },
            "title": "Items",
            "type": "array"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "title": "PlanListView",
        "type": "object"
      },
      "PlanView": {
        "additionalProperties": false,
        "properties": {
          "conditions": {
            "$ref": "#/components/schemas/ResearchConditions-Output"
          },
          "conditionsRevision": {
            "title": "Conditionsrevision",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "conditionsRevision",
          "conditions"
        ],
        "title": "PlanView",
        "type": "object"
      },
      "Preference": {
        "additionalProperties": false,
        "properties": {
          "certainty": {
            "enum": [
              "user_stated",
              "inferred",
              "unknown"
            ],
            "title": "Certainty",
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "intent": {
            "enum": [
              "prefer",
              "keep",
              "change",
              "avoid"
            ],
            "title": "Intent",
            "type": "string"
          },
          "strength": {
            "enum": [
              "soft",
              "hard"
            ],
            "title": "Strength",
            "type": "string"
          }
        },
        "required": [
          "description",
          "intent",
          "certainty",
          "strength"
        ],
        "title": "Preference",
        "type": "object"
      },
      "QuestionView": {
        "additionalProperties": false,
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "prompt": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "waitingVersion": {
            "minimum": 1,
            "title": "Waitingversion",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "prompt",
          "waitingVersion",
          "expiresAt"
        ],
        "title": "QuestionView",
        "type": "object"
      },
      "ResearchCommandView": {
        "additionalProperties": false,
        "properties": {
          "acceptance": {
            "enum": [
              "acceptance_pending",
              "accepted"
            ],
            "title": "Acceptance",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "scope": {
            "const": "research.start",
            "default": "research.start",
            "title": "Scope",
            "type": "string"
          },
          "taskId": {
            "format": "uuid",
            "title": "Taskid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "taskId",
          "acceptance"
        ],
        "title": "ResearchCommandView",
        "type": "object"
      },
      "ResearchConditions-Input": {
        "additionalProperties": false,
        "properties": {
          "budget_twd": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Twd"
          },
          "entry": {
            "enum": [
              "beginner",
              "existing_bottle"
            ],
            "title": "Entry",
            "type": "string"
          },
          "goal": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Goal",
            "type": "string"
          },
          "preferences": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Preference"
            },
            "maxItems": 64,
            "title": "Preferences",
            "type": "array"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "starting_bottle": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CatalogReference"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "entry",
          "goal"
        ],
        "title": "ResearchConditions",
        "type": "object"
      },
      "ResearchConditions-Output": {
        "additionalProperties": false,
        "properties": {
          "budget_twd": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Twd"
          },
          "entry": {
            "enum": [
              "beginner",
              "existing_bottle"
            ],
            "title": "Entry",
            "type": "string"
          },
          "goal": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Goal",
            "type": "string"
          },
          "preferences": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Preference"
            },
            "maxItems": 64,
            "title": "Preferences",
            "type": "array"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "starting_bottle": {
            "anyOf": [
              {
