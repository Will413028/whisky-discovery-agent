{
  "components": {
    "schemas": {
      "ActorView": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "ActorView",
        "type": "object"
      },
      "ErrorView": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "retryable"
        ],
        "title": "ErrorView",
        "type": "object"
      },
      "QuestionView": {
        "additionalProperties": false,
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "prompt": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "waitingVersion": {
            "minimum": 1,
            "title": "Waitingversion",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "prompt",
          "waitingVersion",
          "expiresAt"
        ],
        "title": "QuestionView",
        "type": "object"
      },
      "TaskError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "message": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "TaskError",
        "type": "object"
      },
      "TaskView": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "properties": {
                "question": {
                  "type": "null"
                }
              }
            },
            "if": {
              "properties": {
                "status": {
                  "const": "needs_input"
                }
              }
            },
            "then": {
              "properties": {
                "question": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            }
          },
          {
            "else": {
              "properties": {
                "reportId": {
                  "type": "null"
                }
              }
            },
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "properties": {
                "reportId": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            }
          },
          {
            "else": {
              "properties": {
                "error": {
                  "type": "null"
                }
              }
            },
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "properties": {
                "error": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            }
          }
        ],
        "properties": {
          "conditionsRevision": {
            "minimum": 1,
            "title": "Conditionsrevision",
            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskError"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "format": "date-time",
            "title": "Observedat",
            "type": "string"
          },
          "question": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuestionView"
              },
              {
                "type": "null"
              }
            ]
          },
          "reportId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reportid"
          },
          "schemaVersion": {
            "const": 1,
            "default": 1,
            "title": "Schemaversion",
            "type": "integer"
          },
          "stage": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Stage",
            "type": "string"
          },
          "status": {
            "enum": [
              "acceptance_pending",
              "queued",
              "researching",
              "needs_input",
              "completed",
              "failed",
              "cancelled",
              "superseded"
            ],
            "title": "Status",
            "type": "string"
          },
          "taskId": {
            "format": "uuid",
            "title": "Taskid",
            "type": "string"
          },
          "threadId": {
            "format": "uuid",
            "title": "Threadid",
            "type": "string"
          },
          "viewVersion": {
            "minimum": 1,
            "title": "Viewversion",
            "type": "integer"
          }
        },
        "required": [
          "taskId",
          "threadId",
          "conditionsRevision",
          "viewVersion",
          "status",
          "stage",
          "question",
          "reportId",
          "error",
          "observedAt"
        ],
        "title": "TaskView",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Whisky Discovery Agent",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
