    "ConclusionViewV1": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "alternativeVersionIds": {
                "maxItems": 3
              },
              "selectedBottleName": {
                "type": "null"
              },
              "selectedVersionId": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "outcome": {
                "const": "selected"
              }
            }
          },
          "then": {
            "properties": {
              "alternativeVersionIds": {
                "maxItems": 2
              },
              "selectedBottleName": {
                "not": {
                  "type": "null"
                }
              },
              "selectedVersionId": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "alternativeVersionIds": {
