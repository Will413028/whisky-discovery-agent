          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "evaluatedOn": {
          "format": "date",
          "title": "Evaluatedon",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "selected",
            "no_suitable"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "planId": {
          "format": "uuid",
          "title": "Planid",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "reportId": {
          "format": "uuid",
          "title": "Reportid",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "selectedBottleName": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selectedbottlename"
        },
        "selectedVersionId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selectedversionid"
        },
        "taskId": {
          "format": "uuid",
          "title": "Taskid",
          "type": "string"
        },
        "tradeoff": {
          "title": "Tradeoff",
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "title": "Updatedat",
          "type": "string"
        }
      },
      "required": [
