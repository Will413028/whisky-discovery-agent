# Examples only. Export these into the process environment; no automatic dotenv loading.
WHISKY_DATABASE_URL=postgresql+psycopg://localhost/whisky
WHISKY_AUTH0_ISSUER=https://YOUR-TENANT.auth0.com/
WHISKY_AUTH0_AUDIENCE=https://whisky-api.example
# Research worker only; supply a dedicated Workers AI token at runtime.
WHISKY_CLOUDFLARE_ACCOUNT_ID=YOUR_32_HEX_ACCOUNT_ID
WHISKY_CLOUDFLARE_AI_TOKEN=YOUR_WORKERS_AI_TOKEN
# 0 rejects live inference. Set a lower cap only after checking this account's
# remaining Workers AI Free allocation for the UTC day (maximum 10000).
WHISKY_DAILY_MODEL_NEURONS=0
