[global]
repo1-type=s3
repo1-s3-bucket=whisky-discovery-backups
repo1-s3-endpoint=nrdyiwp0kjd2.compat.objectstorage.ap-tokyo-1.oraclecloud.com
repo1-s3-region=ap-tokyo-1
repo1-s3-uri-style=path
repo1-s3-key=REPLACE_WITH_PROJECT_ONLY_CUSTOMER_ACCESS_KEY
repo1-s3-key-secret=REPLACE_WITH_PROJECT_ONLY_CUSTOMER_SECRET_KEY
repo1-path=/whisky
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_OFF_VM_RECOVERY_PASSPHRASE
repo1-bundle=y
repo1-retention-full-type=time
repo1-retention-full=7
start-fast=y
archive-timeout=60

[whisky]
pg1-path=/var/lib/postgresql/18/docker
pg1-user=whisky
