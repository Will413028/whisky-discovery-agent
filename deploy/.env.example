WHISKY_RELEASE=REPLACE_WITH_COMMIT
WHISKY_WEB_RELEASE=REPLACE_WITH_COMMIT
WHISKY_DB_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
WHISKY_PG_RELEASE=REPLACE_WITH_COMMIT
WHISKY_RUNTIME_DATABASE_URL=postgresql+psycopg://whisky_runtime:REPLACE_WITH_PRODUCT_RUNTIME_PASSWORD@db:5432/whisky
WHISKY_MIGRATION_DATABASE_URL=postgresql+psycopg://whisky_ddl:REPLACE_WITH_PRODUCT_DDL_PASSWORD@db:5432/whisky
WHISKY_AUTH0_ISSUER=https://YOUR-TENANT.auth0.com/
WHISKY_AUTH0_DOMAIN=YOUR-TENANT.auth0.com
WHISKY_AUTH0_CLIENT_ID=REPLACE_WITH_PUBLIC_SPA_ID
WHISKY_AUTH0_AUDIENCE=https://whisky-discovery-api
# Set all three together when the dedicated Temporal service is provisioned.
WHISKY_TEMPORAL_ADDRESS=
WHISKY_TEMPORAL_NAMESPACE=
WHISKY_TEMPORAL_TASK_QUEUE=
