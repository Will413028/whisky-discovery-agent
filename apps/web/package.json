{
  "name": "@whisky/web",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:contracts": "openapi-typescript ../../contracts/openapi.json -o ../../contracts/api.d.ts && node scripts/generate-task-validator.mjs",
    "dev": "vite --host 127.0.0.1 --port 3417 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3418 --strictPort",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit",
    "check:boundaries": "node scripts/check-source.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59",
    "@auth0/auth0-react": "2.27.0",
    "eventsource-parser": "4.1.1",
    "next": "16.3.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.0-beta.13"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@cloudflare/vite-plugin": "1.61.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.1",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.142.0"
  }
}
